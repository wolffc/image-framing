{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "incremental": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@payload-config": ["./payload.config.ts"],
      "@wolffc/payload-image-framing": ["../src/index.ts"],
      "@wolffc/payload-image-framing/client": ["../src/exports/client.ts"],
      "@wolffc/payload-image-framing/core": ["../src/core/index.ts"],
      "@wolffc/payload-image-framing/next": ["../src/next/index.ts"],
      "@wolffc/payload-image-framing/server": ["../src/exports/server.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mjs",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
