{
  "name": "@wolffc80/payload-image-framing",
  "version": "0.1.0-beta.0",
  "description": "Non-destructive crop and focus areas for Payload CMS uploads, with per-usage overrides and cover areas",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "image-crop",
    "focal-point",
    "focus-area",
    "nextjs",
    "s3"
  ],
  "homepage": "https://github.com/wolffc/image-framing#readme",
  "bugs": {
    "url": "https://github.com/wolffc/image-framing/issues"
  },
  "license": "MIT",
  "author": "Christian Wolff <chris@wolffc.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolffc/image-framing.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./server": {
      "types": "./src/exports/server.ts",
      "import": "./src/exports/server.ts",
      "default": "./src/exports/server.ts"
    },
    "./client": {
      "types": "./src/exports/client.ts",
      "import": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "import": "./src/next/index.ts",
      "default": "./src/next/index.ts"
    },
    "./s3": {
      "types": "./src/s3/index.ts",
      "import": "./src/s3/index.ts",
      "default": "./src/s3/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:types && pnpm build:swc",
    "build:examples": "bash scripts/build-examples.sh",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "next dev dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:importmap": "pnpm dev:payload generate:importmap",
    "generate:types": "pnpm dev:payload generate:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm build",
    "prepublishOnly": "node scripts/require-pnpm.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "test:int": "vitest run --project int",
    "test:pack": "bash scripts/pack-smoke.sh",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p dev/tsconfig.json && tsc --noEmit -p examples/tsconfig.snippets.json"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.614.0",
    "@payloadcms/ui": "^3.39.0",
    "next": "^15.2.3 || ^16.0.0",
    "payload": "^3.39.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@changesets/cli": "^3.0.3",
    "@payloadcms/db-mongodb": "3.91.0",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@playwright/test": "1.64.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "3.91.0",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@10.34.7",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js",
        "default": "./dist/core/index.js"
      },
      "./server": {
        "types": "./dist/exports/server.d.ts",
        "import": "./dist/exports/server.js",
        "default": "./dist/exports/server.js"
      },
      "./client": {
        "types": "./dist/exports/client.d.ts",
        "import": "./dist/exports/client.js",
        "default": "./dist/exports/client.js"
      },
      "./next": {
        "types": "./dist/next/index.d.ts",
        "import": "./dist/next/index.js",
        "default": "./dist/next/index.js"
      },
      "./s3": {
        "types": "./dist/s3/index.d.ts",
        "import": "./dist/s3/index.js",
        "default": "./dist/s3/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
